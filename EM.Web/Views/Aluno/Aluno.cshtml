@using EM.Web.Models
@using EM.Domain.Enums
@model AlunoModel

@{
    bool isEdicao = Model.Matricula > 0;
    string titulo = isEdicao ? "Editar Aluno" : "Cadastrar Aluno";

    ViewData["Title"] = titulo;
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <div class="card">
                <div class="card-header">
                    <h2>@ViewData["Title"]</h2>
                </div>
                <div class="card-body">
                    <form asp-controller="Aluno" asp-action="Salvar" method="post">
                        @if (isEdicao)
                        {
                            <input type="hidden" asp-for="Matricula" />
                        }

                        <div class="form-group mb-3">
                            <label asp-for="Nome" class="form-label"></label>
                            <input asp-for="Nome" class="form-control" />
                            <span asp-validation-for="Nome" class="text-danger"></span>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="Cpf" class="form-label"></label>
                            <input asp-for="Cpf" class="form-control" id="cpf" maxlength="14" placeholder="000.000.000-00" />
                            <span asp-validation-for="Cpf" class="text-danger"></span>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="DataNascimento" class="form-label"></label>
                            <input asp-for="DataNascimento" type="date" class="form-control" />
                            <span asp-validation-for="DataNascimento" class="text-danger"></span>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="EnumeradorSexo" class="form-label"></label>
                            <select asp-for="EnumeradorSexo" class="form-select"
                                    asp-items="Html.GetEnumSelectList<EnumeradorSexo>()">
                            </select>
                            <span asp-validation-for="EnumeradorSexo" class="text-danger"></span>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="Cidade.Descricao" class="form-label"></label>
                            <select asp-for="Cidade.Codigo" class="form-select"
                                    asp-items="ViewBag.Cidades">
                                <option value="">Selecione uma cidade</option>
                            </select>
                        </div>

                        <div class="form-group mt-5">
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-save"></i> @(isEdicao ? "Salvar Alterações" : "Cadastrar")
                            </button>
                            <a asp-controller="Home" asp-action="Index" class="btn btn-secondary">
                                <i class="bi bi-arrow-left"></i> Voltar
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.getElementById("cpf").addEventListener("input", function (e) {
            let cpf = e.target.value;

            cpf = cpf.replace(/\D/g, "");
            cpf = cpf.replace(/(\d{3})(\d)/, "$1.$2");
            cpf = cpf.replace(/(\d{3})(\d)/, "$1.$2");
            cpf = cpf.replace(/(\d{3})(\d{1,2})$/, "$1-$2");

            e.target.value = cpf;
        });
    </script>
}
